{
    "name": "voicebot-monorepo",
    "version": "1.0.0",
    "private": true,
    "description": "VoiceBot — Multilingual RAG AI Voice Agent",
    "scripts": {
        "dev": "npm run dev:frontend",
        "dev:frontend": "cd frontend && npm run dev",
        "dev:mobile": "cd mobile && npx expo start",
        "build:frontend": "cd frontend && npm run build",
        "install:frontend": "cd frontend && npm install",
        "install:mobile": "cd mobile && npm install",
        "install:all": "npm run install:frontend && npm run install:mobile"
    }
}